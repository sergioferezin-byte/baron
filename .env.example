# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=

# DEEPSEEK_API_KEY: OBRIGATÓRIA para o chat principal (O Barão conversa via DeepSeek).
# Crie em https://platform.deepseek.com > API Keys. Os demais recursos (diário,
# crônicas, músicas, meditação) continuam usando a GEMINI_API_KEY.
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL: Opcional. Padrão: deepseek-chat (use deepseek-reasoner para respostas mais elaboradas e caras).
DEEPSEEK_MODEL=

# ===== VOZ DO BARÃO =====
# Ordem: Azure (principal) > Gemini (reserva) > voz do navegador.
#
# AZURE_SPEECH_KEY: Chave do Azure AI Speech. Portal do Azure > Speech service
# > Keys and Endpoint > KEY 1. A camada gratuita F0 dá 500 mil caracteres por
# mês, para sempre, com limite rígido (não gera cobrança). Sem ela, o app usa
# a reserva do Gemini.
AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION: Região do recurso Speech, como aparece no portal
# (ex.: brazilsouth, eastus). Padrão: brazilsouth. Precisa casar com a chave.
AZURE_SPEECH_REGION=
# AZURE_TTS_VOICE: Opcional. Vozes masculinas pt-BR: pt-BR-AntonioNeural,
# pt-BR-DonatoNeural, pt-BR-FabioNeural, pt-BR-HumbertoNeural,
# pt-BR-JulioNeural, pt-BR-NicolauNeural, pt-BR-ValerioNeural.
# Padrão: pt-BR-AntonioNeural.
AZURE_TTS_VOICE=
# AZURE_TTS_RATE: Opcional. Ritmo da fala; negativo deixa mais pausado.
# Padrão: -8%.
AZURE_TTS_RATE=

# KIE_API_KEY: Chave do kie.ai (https://kie.ai > API Key). Usada pelas
# imagens do Álbum e pelas músicas do Ateliê. A voz do Barão NÃO passa mais
# por aqui: a ponte do kie.ai com a ElevenLabs está fora do ar desde
# jul/2026 (ver /api/voice/speak, mantido para retestar o fornecedor).
KIE_API_KEY=
# KIE_TTS_VOICE: Opcional. ID da voz ElevenLabs no kie.ai.
# Padrão: 6F5Zhi321D3Oq7v1oNT4 (Hank — narrador profundo e envolvente).
KIE_TTS_VOICE=
# KIE_TTS_MODEL: Opcional. Padrão: elevenlabs/text-to-speech-turbo-2-5
# (metade do preço do multilingual-v2, mesmas vozes). Para qualidade máxima,
# use elevenlabs/text-to-speech-multilingual-v2.
KIE_TTS_MODEL=

# BARAO_REFERENCE_IMAGE_URL: Opcional. URL pública do retrato oficial do
# Barão usado como referência de rosto nas imagens do Álbum.
BARAO_REFERENCE_IMAGE_URL=

# SUNO_MODEL: Opcional. Modelo do Suno usado no Ateliê de Composição.
# Padrão: V5. Outros: V4, V4_5, V4_5PLUS, V5_5 (usa a mesma KIE_API_KEY).
SUNO_MODEL=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL=

# ADMIN_PASSWORD: Opcional. Senha customizada de acesso ao painel de administração (/admin).
# Se não preenchida, o valor padrão de segurança é 'barao123'.
ADMIN_PASSWORD=

# SUPABASE CONFIGURATION
# VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY: Supabase > Project Settings > API
# SUPABASE_SERVICE_ROLE_KEY: OBRIGATÓRIA no servidor para criar usuários no
# Supabase Auth (Authentication). Sem ela, cadastro/login via Supabase falham.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# DATABASE (preferido): connection string do Postgres do Supabase.
# Supabase > Project Settings > Database > Connection string (Session pooler).
# Ex.: postgresql://postgres.xxxx:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
DATABASE_URL=
# Defina DATABASE_SSL=false apenas para Postgres local sem TLS.
DATABASE_SSL=

# LEGACY: variáveis discretas (Cloud SQL). Usadas somente se DATABASE_URL estiver vazia.
SQL_HOST=
SQL_PORT=
SQL_DB_NAME=
SQL_USER=
SQL_PASSWORD=
SQL_SSL=
SQL_ADMIN_USER=
SQL_ADMIN_PASSWORD=

